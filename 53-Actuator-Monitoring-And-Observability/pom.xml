<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topic 53 - Actuator, Monitoring and Observability
  Run:   mvn spring-boot:run
  Open:  http://localhost:8080/actuator   (list of exposed endpoints)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.course</groupId>
    <artifactId>actuator-observability</artifactId>
    <version>1.0.0</version>
    <name>53-Actuator-Monitoring-And-Observability</name>
    <description>Order service with Actuator, custom health, info and Micrometer metrics</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Production-ready features: /actuator/health, /info, /metrics, /loggers ...
             Also brings Micrometer (the metrics library) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Adds the /actuator/prometheus endpoint: all metrics in the text format Prometheus understands.
             Version is managed by Spring Boot. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Writes META-INF/build-info.properties (artifact, version, build time).
                             Actuator shows it automatically under "build" in /actuator/info. -->
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
