<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topic 34 - Validation
  Jakarta Bean Validation (Hibernate Validator) in a Spring Boot REST API:
  built-in constraints, @Valid, method validation of path/query params,
  nested validation, custom constraints and validation groups.
  Run with:  mvn spring-boot:run        Tests:  mvn test
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.course</groupId>
    <artifactId>validation</artifactId>
    <version>1.0.0</version>
    <name>34 - Validation</name>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          THE important dependency of this topic.
          Brings jakarta.validation-api (the annotations like @NotBlank)
          + Hibernate Validator (the engine that checks them).
          Without it, @Valid and @NotBlank are silently IGNORED.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
