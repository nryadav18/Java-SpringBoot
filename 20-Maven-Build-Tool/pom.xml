<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topic 20 - Maven Build Tool
  ===========================
  pom.xml = "Project Object Model". It is the RECIPE of the project:
  who we are, which libraries we need, and how to build us.
  Read it top to bottom - every element has a comment.

  Useful commands (run in this folder):
    mvn compile                 compile src/main/java      -> target/classes
    mvn test                    compile + run unit tests   -> target/surefire-reports
    mvn package                 compile + test + build JAR -> target/*.jar
    mvn clean                   delete the target/ folder
    mvn -q compile exec:java    run the main class (exec plugin)
    java -jar target/maven-demo-1.0.0.jar     run the packaged "fat" JAR
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Version of the POM format itself. Always 4.0.0 for Maven 3. -->
    <modelVersion>4.0.0</modelVersion>

    <!-- ================= GAV coordinates: the project's "address" ================= -->
    <groupId>com.course</groupId>            <!-- G: who owns it (reverse domain name) -->
    <artifactId>maven-demo</artifactId>      <!-- A: the project's name -->
    <version>1.0.0</version>                 <!-- V: its version (-SNAPSHOT = still in development) -->
    <packaging>jar</packaging>               <!-- what to build: jar (default), war, pom -->

    <!-- Human-friendly info (optional) -->
    <name>Maven Demo - Shop Label Printer</name>
    <description>A tiny project that shows how Maven builds, tests and packages Java code.</description>

    <!-- ================= Properties: named values (like variables) ================= -->
    <properties>
        <!-- Compile for Java 17 -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Read/write source files as UTF-8 on every OS (avoids broken characters on Windows) -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Our own properties: keep versions in ONE place, use them as ${...} below -->
        <commons-lang3.version>3.17.0</commons-lang3.version>
        <junit.version>5.11.4</junit.version>
        <main.class>com.course.mavendemo.App</main.class>
    </properties>

    <!-- ================= Dependencies: libraries we use ================= -->
    <dependencies>
        <!-- Apache Commons Lang: handy helpers for Strings, numbers, etc.
             Scope "compile" (the default): needed to compile, test AND run. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>

        <!-- JUnit 5: only needed for TESTS. Scope "test" means it is NOT part of the
             final JAR and src/main/java cannot use it. (Testing is Topic 21.) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ================= Build: how to build, which plugins to use ================= -->
    <build>
        <!-- Resource FILTERING: replace ${...} placeholders inside src/main/resources files
             (we use it to put the project version into app.properties). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- Compiles Java code (bound to the 'compile' phase). Pinning versions = repeatable builds. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Runs unit tests in the 'test' phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!-- Lets us run the app with:  mvn -q compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <!-- Shade plugin: in the 'package' phase it builds a "fat" (uber) JAR that contains
                 OUR classes + ALL runtime dependencies, and writes Main-Class into the manifest.
                 Result: java -jar target/maven-demo-1.0.0.jar just works.
                 (Spring Boot has its own plugin that does this - spring-boot-maven-plugin.) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <!-- drop signature/metadata files of dependencies (avoids warnings) -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
