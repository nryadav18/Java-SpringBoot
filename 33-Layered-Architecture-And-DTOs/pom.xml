<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topic 33 - Layered Architecture & DTOs
  A clean "Employee Management" REST API split into layers:
  controller -> service -> repository, with DTOs (records) and a manual mapper.
  Run with:  mvn spring-boot:run
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent: gives us tested versions of every Spring library -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.course</groupId>
    <artifactId>layered-architecture</artifactId>
    <version>1.0.0</version>
    <name>33 - Layered Architecture and DTOs</name>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Web layer: Spring MVC + embedded Tomcat + Jackson (JSON) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          NOTE: We deliberately do NOT use Lombok in this project.
          The lesson explains Lombok and shows exactly what you would add
          (dependency + annotation processor config) if your team uses it.
        -->

        <!-- Testing: JUnit 5 + AssertJ + Mockito + MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lets us run "mvn spring-boot:run" and build an executable jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
