<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topic 57 - Messaging with RabbitMQ
  1) docker compose up -d          (starts RabbitMQ, UI at http://localhost:15672  guest/guest)
  2) mvn spring-boot:run           (app on http://localhost:8080)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.course</groupId>
    <artifactId>rabbitmq-orders</artifactId>
    <version>1.0.0</version>
    <name>57-Messaging-With-RabbitMQ</name>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- AMQP = the protocol RabbitMQ speaks. This starter brings Spring AMQP:
             RabbitTemplate (send), @RabbitListener (receive), RabbitAdmin (declare queues). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- REST endpoint to place orders -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
