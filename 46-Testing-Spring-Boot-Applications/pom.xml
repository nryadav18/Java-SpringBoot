<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topic 46 - Testing Spring Boot Applications

  A small Library "Book API" with a full set of tests:
    * BookServiceTest          - plain unit test with Mockito (@Mock, @InjectMocks, verify)
    * BookControllerTest       - @WebMvcTest + MockMvc + @MockitoBean (web slice)
    * BookRepositoryTest       - @DataJpaTest with H2 (JPA slice)
    * BookApiIntegrationTest   - @SpringBootTest(RANDOM_PORT) + TestRestTemplate (everything)

  Run all tests:        mvn test
  Coverage report:      mvn test   -> open target/site/jacoco/index.html
  Tests + coverage gate: mvn verify
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.course</groupId>
    <artifactId>testing-demo</artifactId>
    <version>1.0.0</version>
    <name>46-Testing-Spring-Boot-Applications</name>
    <description>Unit, slice and integration tests for a Spring Boot app</description>

    <properties>
        <java.version>17</java.version>
        <jacoco.version>0.8.13</jacoco.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ONE dependency, a whole testing toolbox:
             JUnit 5, Mockito, AssertJ, Hamcrest, MockMvc (spring-test),
             JSONPath, JSONassert, Awaitility ... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- JaCoCo = Java Code Coverage. Measures which lines the tests executed. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!-- 1. Before tests: attach the JaCoCo agent to the test JVM -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- 2. After tests: write the HTML report to target/site/jacoco/index.html -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- 3. On "mvn verify": FAIL the build if line coverage is below 70 % -->
                    <execution>
                        <id>check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
