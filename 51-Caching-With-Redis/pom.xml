<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topic 51 - Caching with Redis
  Run (default profile, in-memory cache, NO Redis needed):   mvn spring-boot:run
  Run with Redis (start it first: docker compose up -d):     mvn spring-boot:run -Dspring-boot.run.profiles=redis
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.course</groupId>
    <artifactId>caching-with-redis</artifactId>
    <version>1.0.0</version>
    <name>51-Caching-With-Redis</name>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- REST endpoints (embedded Tomcat + Jackson) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring's cache abstraction: @EnableCaching, @Cacheable, @CachePut, @CacheEvict -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Redis client (Lettuce) + RedisTemplate + RedisCacheManager.
             It is on the classpath all the time, but we only USE Redis in the "redis" profile.
             Lettuce connects lazily, so the app still starts when no Redis server is running. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
