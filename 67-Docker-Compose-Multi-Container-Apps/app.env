# ---------------------------------------------------------------
# app.env - extra environment variables for the "app" container only.
# Loaded by "env_file: - app.env" in docker-compose.yml.
# Keep NON-secret settings here. Secrets go in .env (not committed).
#
# Spring Boot "relaxed binding": LOGGING_LEVEL_COM_COURSE becomes logging.level.com.course
# ---------------------------------------------------------------
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
LOGGING_LEVEL_COM_COURSE=DEBUG
TZ=UTC
