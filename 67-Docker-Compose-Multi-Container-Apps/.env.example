# ---------------------------------------------------------------
# Copy this file to ".env" (same folder as docker-compose.yml):
#     copy .env.example .env        (Windows cmd)
#     Copy-Item .env.example .env   (PowerShell)
# Docker Compose reads ".env" automatically and replaces ${...} in docker-compose.yml.
#
# NEVER commit the real .env to Git - it is in .gitignore.
# Commit only this ".env.example" with safe dummy values.
# ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=librarydb
DB_USER=library
DB_PASSWORD=change-me-app
