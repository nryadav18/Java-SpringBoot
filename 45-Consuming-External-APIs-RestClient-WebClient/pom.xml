<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topic 45 - Consuming External APIs: RestTemplate, RestClient, WebClient, HTTP interfaces

  Our app calls the free fake REST API https://jsonplaceholder.typicode.com
  in four different ways. With the "offline" profile it calls a built-in mock
  instead (no internet needed).

  Run (internet): mvn spring-boot:run
  Run (offline) : mvn spring-boot:run -Dspring-boot.run.profiles=offline
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.course</groupId>
    <artifactId>api-client</artifactId>
    <version>1.0.0</version>
    <name>45-Consuming-External-APIs-RestClient-WebClient</name>
    <description>Calling other HTTP APIs from Spring Boot</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Our own REST API (Spring MVC + Tomcat). Also brings RestTemplate and RestClient. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Only needed for WebClient (the reactive client).
             Because spring-boot-starter-web is ALSO present, the app still runs
             on Tomcat + Spring MVC; WebFlux is used only as an HTTP client library. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
