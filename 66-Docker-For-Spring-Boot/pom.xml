<?xml version="1.0" encoding="UTF-8"?>
<!--
  docker-demo (Topic 66) - a tiny Spring Boot app that we package into a Docker image.
  Run locally:      mvn spring-boot:run                (http://localhost:8080/api/hello)
  Build the jar:    mvn clean package                  (target/docker-demo.jar)
  Docker image:     docker build -t docker-demo:1.0 .  (uses the Dockerfile in this folder)
  Buildpacks:       mvn spring-boot:build-image        (NO Dockerfile needed)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.course</groupId>
    <artifactId>docker-demo</artifactId>
    <version>1.0.0</version>
    <name>docker-demo</name>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- /actuator/health is used by the Docker HEALTHCHECK (and later by Kubernetes probes) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- A fixed jar name (docker-demo.jar instead of docker-demo-1.0.0.jar)
             makes the Dockerfile simpler: COPY target/docker-demo.jar -->
        <finalName>docker-demo</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Settings for "mvn spring-boot:build-image" (Cloud Native Buildpacks) -->
                    <image>
                        <name>docker-demo-buildpacks:${project.version}</name>
                        <env>
                            <BP_JVM_VERSION>17</BP_JVM_VERSION>
                        </env>
                    </image>
                    <!-- Layered jars are ON by default since Boot 2.4; shown here so you know it exists -->
                    <layers>
                        <enabled>true</enabled>
                    </layers>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
