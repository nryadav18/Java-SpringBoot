<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topic 35 - Global Exception Handling
  A Library "Book" API that turns every error into a clean, consistent JSON response
  using custom exceptions, @RestControllerAdvice, an ErrorResponse DTO and ProblemDetail (RFC 9457).
  Run with:  mvn spring-boot:run
             mvn spring-boot:run -Dspring-boot.run.profiles=problem   (ProblemDetail style)
             mvn spring-boot:run -Dspring-boot.run.profiles=plain     (Spring Boot default errors)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.course</groupId>
    <artifactId>global-exception-handling</artifactId>
    <version>1.0.0</version>
    <name>35 - Global Exception Handling</name>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Validation from topic 34 - we now handle its errors nicely -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
