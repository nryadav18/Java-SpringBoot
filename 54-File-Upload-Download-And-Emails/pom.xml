<?xml version="1.0" encoding="UTF-8"?>
<!--
  Topic 54 - File Upload, Download and Emails
  Run:   mvn spring-boot:run          then open http://localhost:8080  (simple upload page)
  Mail:  docker compose up -d          then open http://localhost:8025  (Mailpit inbox)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.course</groupId>
    <artifactId>file-upload-download-emails</artifactId>
    <version>1.0.0</version>
    <name>54-File-Upload-Download-And-Emails</name>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- REST + multipart (file upload) support -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation of the email request bodies (@NotBlank, @Email) - topic 34 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JavaMailSender (Jakarta Mail / Angus Mail) - auto-configured when spring.mail.host is set -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
